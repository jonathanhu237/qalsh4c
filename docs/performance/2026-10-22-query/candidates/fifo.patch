+void TableScanSchedule::grow_pending() {
+    const std::size_t old_capacity = pending_tables_.size();
+    const std::size_t maximum = pending_tables_.max_size();
+    if (old_capacity == maximum) {
+        throw std::length_error("table scan schedule queue is too large");
+    }
+    const std::size_t new_capacity = old_capacity == 0 ? 1
+        : old_capacity > maximum - old_capacity ? maximum : old_capacity * 2;
+    std::vector<std::uint32_t> grown(new_capacity);
+    if (pending_count_ != 0) {
+        const std::size_t first_count = std::min(pending_count_, old_capacity - pending_head_);
+        std::copy_n(pending_tables_.begin() + pending_head_, first_count, grown.begin());
+        std::copy_n(pending_tables_.begin(), pending_count_ - first_count,
+                    grown.begin() + first_count);
+    }
+    pending_tables_.swap(grown);
+    pending_head_ = 0;
