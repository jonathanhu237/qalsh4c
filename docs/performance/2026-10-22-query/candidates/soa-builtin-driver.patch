+inline void ForEachHitIdTraversal(const HitRange& range, Visitor&& visitor) {
+    static_assert(sizeof(Projection) == 4 && sizeof(PointId) == 4);
+    const auto* first = range.first;
+    const auto* point_ids = range.point_ids;
+    const auto count = range.count;
+    for (std::size_t i = 0; i < count; ++i) {
+        PointId id;
+        if constexpr (Separate) {
+            id = *(Reverse ? point_ids - i : point_ids + i);
+        } else {
+            const auto* bytes = Reverse ? first - i * 8U : first + i * 8U;
+            std::memcpy(&id, bytes + sizeof(Projection), sizeof(id));
+        }
+        visitor(id, i);
+    }
+}
