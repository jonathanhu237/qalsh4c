+// Keep each built-in traversal outside the general callback dispatcher. This
+// prevents its four layouts from expanding one function around the hot loop.
+template <bool Reverse, bool Separate>
+#if defined(__GNUC__) || defined(__clang__)
+[[gnu::noinline]]
+#endif
+void DeliverBuiltinRange(RangeExecution& execution, const HitRange& range) {
+    auto& strategy = *static_cast<DefaultQalshStrategy*>(execution.strategy);
+    auto state = execution.state.projection_hits;
+    // Within a range, only an evaluation callback can request a stop.
+    bool accepting = !strategy.finish_requested_;
+    ForEachHitIdTraversal<Reverse, Separate>(range, [&](PointId point_id, std::size_t position) {
+        if (!accepting) return;
+        const HitDecision decision = strategy.accept_builtin_id(point_id);
+        if (decision.has_candidate()) {
+            execution.state.projection_hits = state + position + 1;
+            execution.evaluate(execution, decision.candidate);
+            accepting = !strategy.finish_requested_;
+        }
+    });
+    // A callback may stop acceptance, but cursor and hit accounting still
+    // consume the complete range supplied by the index.
+    execution.state.projection_hits = state + range.count;
 }
 
