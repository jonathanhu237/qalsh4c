--- /dev/null
+++ b/src/qalsh/tests/separate_range_test.cc
@@ -0,0 +1,198 @@
+#include "window_clamp.h"
+
+#include <algorithm>
+#include <array>
+#include <bit>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <iostream>
+#include <limits>
+#include <random>
+#include <stdexcept>
+#include <vector>
+
+namespace {
+
+using qalsh::PointId;
+using qalsh::Projection;
+using qalsh::ProjectionHit;
+using qalsh::detail::HitRange;
+
+void Check(bool condition, const char* message) {
+    if (!condition) throw std::runtime_error(message);
+}
+
+[[nodiscard]] std::uint32_t Bits(float value) {
+    return std::bit_cast<std::uint32_t>(value);
+}
+
+struct Entry {
+    Projection value;
+    PointId point_id;
+};
+static_assert(sizeof(Entry) == 8U && offsetof(Entry, point_id) == 4U);
+
+struct Ranges {
+    std::vector<Entry> entries;
+    std::vector<Projection> values;
+    std::vector<PointId> ids;
+    PointId empty_id{0};
+
+    explicit Ranges(const std::vector<Projection>& logical, bool reverse)
+        : entries(logical.size()), values(logical.size()), ids(logical.size()) {
+        for (std::size_t i = 0; i < logical.size(); ++i) {
+            entries[i] = {logical[i], std::numeric_limits<PointId>::max() -
+                                         static_cast<PointId>(37U * i)};
+        }
+        if (reverse) std::reverse(entries.begin(), entries.end());
+        for (std::size_t i = 0; i < entries.size(); ++i) {
+            values[i] = entries[i].value;
+            ids[i] = entries[i].point_id;
+        }
+    }
+
+    [[nodiscard]] HitRange packed(Projection query, bool reverse) const {
+        const auto* first = entries.empty() ? nullptr : entries.data() +
+                                                           (reverse ? entries.size() - 1U : 0U);
+        return {reinterpret_cast<const std::byte*>(first), entries.size(), reverse, 23U, query};
+    }
+
+    [[nodiscard]] HitRange separate(Projection query, bool reverse) const {
+        const std::size_t start = reverse && !values.empty() ? values.size() - 1U : 0U;
+        const auto* first = values.empty() ? nullptr : values.data() + start;
+        const auto* first_id = ids.empty() ? &empty_id : ids.data() + start;
+        return {reinterpret_cast<const std::byte*>(first), values.size(), reverse, 23U, query,
+                first_id};
+    }
+};
+
+void CheckHit(const ProjectionHit& hit, const std::vector<Projection>& logical,
+               Projection query, std::size_t position, bool difference) {
+    Check(hit.table_id == 23U, "table ID changed");
+    Check(hit.point_id == std::numeric_limits<PointId>::max() - 37U * position,
+          "point ID or hit order changed");
+    Check(Bits(hit.projected_value) == Bits(logical[position]), "projection bits changed");
+    Check(Bits(hit.query_value) == Bits(query), "query bits changed");
+    const float expected = difference ? std::abs(query - logical[position]) : 0.0F;
+    Check(Bits(hit.absolute_difference) == Bits(expected), "difference bits changed");
+}
+
+void CheckRange(const std::vector<Projection>& logical, Projection query, float bound,
+                 bool reverse) {
+    Ranges storage(logical, reverse);
+    auto separate = storage.separate(query, reverse);
+    auto packed = storage.packed(query, reverse);
+    const auto original = separate;
+    std::size_t expected = 0U;
+    while (expected < logical.size() && std::abs(query - logical[expected]) <= bound) ++expected;
+    qalsh::window_detail::ClampToWindow(separate, bound);
+    qalsh::window_detail::ClampToWindow(packed, bound);
+    Check(separate.count == expected && packed.count == expected, "window prefix changed");
+    Check(separate.first == original.first && separate.point_ids == original.point_ids &&
+              separate.reverse == original.reverse && separate.table_id == original.table_id &&
+              Bits(separate.query_value) == Bits(original.query_value),
+          "window clamp changed range identity");
+
+    for (const auto& range : {separate, packed}) {
+        std::size_t visited = 0U;
+        qalsh::detail::ForEachHit(range, [&](const ProjectionHit& hit, std::size_t position) {
+            Check(position == visited++, "full visitor position changed");
+            CheckHit(hit, logical, query, position, true);
+        });
+        Check(visited == expected, "full visitor count changed");
+        visited = 0U;
+        qalsh::detail::ForEachHit<false>(range, [&](const ProjectionHit& hit) {
+            CheckHit(hit, logical, query, visited++, false);
+        });
+        Check(visited == expected, "single-argument visitor count changed");
+        visited = 0U;
+        auto id_range = range;
+        // The separate ID path must not read the projection stream at all.
+        if (id_range.point_ids != nullptr) id_range.first = nullptr;
+        qalsh::detail::ForEachHitId(id_range, [&](PointId id, std::size_t position) {
+            Check(position == visited++, "ID visitor position changed");
+            Check(id == std::numeric_limits<PointId>::max() - 37U * position,
+                  "ID visitor order changed");
+        });
+        Check(visited == expected, "ID visitor count changed");
+    }
+}
+
+void TestCutoffsAndTails() {
+    for (std::size_t count = 0U; count <= 129U; ++count) {
+        for (bool reverse : {false, true}) {
+            std::vector<Projection> logical(count);
+            for (std::size_t i = 0; i < count; ++i) {
+                logical[i] = static_cast<float>(i / 3U) * (reverse ? -1.0F : 1.0F);
+            }
+            for (std::size_t cutoff = 0U; cutoff <= count; ++cutoff) {
+                const float distance = static_cast<float>(cutoff / 3U);
+                CheckRange(logical, -0.0F, distance, reverse);
+                if (distance > 0.0F) {
+                    CheckRange(logical, 0.0F, std::nextafter(distance, 0.0F), reverse);
+                }
+            }
+            CheckRange(logical, 0.0F, std::numeric_limits<float>::infinity(), reverse);
+        }
+    }
+}
+
+void TestFloatBoundaries() {
+    const float denorm = std::numeric_limits<float>::denorm_min();
+    const float maximum = std::numeric_limits<float>::max();
+    const std::vector<Projection> sorted{-maximum, -1.0F, -denorm, -0.0F,
+                                         0.0F, denorm, 1.0F, maximum};
+    const std::array<float, 8> bounds{0.0F, denorm, std::nextafter(1.0F, 0.0F), 1.0F,
+                                     std::nextafter(1.0F, 2.0F),
+                                     std::nextafter(maximum, 0.0F), maximum,
+                                     std::numeric_limits<float>::infinity()};
+    for (Projection query : sorted) {
+        const auto split = std::lower_bound(sorted.begin(), sorted.end(), query);
+        const std::vector<Projection> right(split, sorted.end());
+        std::vector<Projection> left(sorted.begin(), split);
+        std::reverse(left.begin(), left.end());
+        for (float bound : bounds) {
+            CheckRange(right, query, bound, false);
+            CheckRange(left, query, bound, true);
+        }
+    }
+}
+
+void TestRandomSubranges() {
+    std::mt19937 random(20261022U);
+    std::uniform_int_distribution<int> values(-500, 500);
+    std::uniform_real_distribution<float> queries(-70.0F, 70.0F);
+    std::uniform_real_distribution<float> bounds(0.0F, 100.0F);
+    for (std::size_t count : {17U, 31U, 65U, 127U, 129U, 257U, 1025U}) {
+        for (unsigned repetition = 0U; repetition < 40U; ++repetition) {
+            std::vector<Projection> sorted(count);
+            for (auto& value : sorted) value = static_cast<float>(values(random)) / 8.0F;
+            std::sort(sorted.begin(), sorted.end());
+            const Projection query = queries(random);
+            const float bound = bounds(random);
+            const auto split = std::lower_bound(sorted.begin(), sorted.end(), query);
+            const std::vector<Projection> right(split, sorted.end());
+            std::vector<Projection> left(sorted.begin(), split);
+            std::reverse(left.begin(), left.end());
+            for (bool reverse : {false, true}) {
+                const auto& side = reverse ? left : right;
+                for (std::size_t length : {0U, 1U, 3U, 4U, 5U, 7U, 8U, 16U, 17U, 65U}) {
+                    if (length > side.size()) continue;
+                    CheckRange({side.begin(), side.begin() + length}, query, bound, reverse);
+                }
+                CheckRange(side, query, bound, reverse);
+            }
+        }
+    }
+}
+
+}  // namespace
+
+int main() {
+    TestCutoffsAndTails();
+    TestFloatBoundaries();
+    TestRandomSubranges();
+    std::cout << "separate range checks passed ("
+              << (qalsh::window_detail::UsesSse2() ? "sse2" : "scalar") << ")\n";
+}
